# Copy to .env (which is git-ignored) and fill in. These keys are used ONLY by tools/voice-gen.js on your
# machine. They are never read by the game and never reach the browser.
ELEVENLABS_API_KEY=
# ELEVENLABS_BASE_URL=https://api.elevenlabs.io          # api.in.residency.elevenlabs.io for India data residency

# Azure AI Speech (only if "provider" is "azure" in voice/voice-config.json)
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=centralindia
